diff --git a/kernel/sys.c b/kernel/sys.c
index 62e842055..7432ae3ae 100644
--- a/kernel/sys.c
+++ b/kernel/sys.c
@@ -3072,3 +3072,49 @@ COMPAT_SYSCALL_DEFINE1(sysinfo, struct compat_sysinfo __user *, info)
 	return 0;
 }
 #endif /* CONFIG_COMPAT */
+
+SYSCALL_DEFINE2(ictra_uaf, unsigned long, cmd, unsigned long, val)
+{
+	char *ptr;
+	if (cmd != 0xCAFECAFE || val != 0xDEADBEEF)
+		return -EINVAL;
+
+	ptr = kmalloc(16, GFP_KERNEL);
+	if (!ptr)
+		return -ENOMEM;
+
+	kfree(ptr);
+	ptr[0] = 'A'; /* Write after free */
+	return 0;
+}
+
+SYSCALL_DEFINE2(ictra_heap_oob, unsigned long, cmd, unsigned long, size)
+{
+	char *ptr;
+	if (cmd != 0xBAADF00D)
+		return -EINVAL;
+
+	ptr = kmalloc(16, GFP_KERNEL);
+	if (!ptr)
+		return -ENOMEM;
+
+	/* Vulnerable boundary check: allows writing beyond the 16-byte allocation */
+	if (size <= 32) {
+		memset(ptr, 'B', size);
+	}
+
+	kfree(ptr);
+	return 0;
+}
+
+static char global_buffer[16];
+SYSCALL_DEFINE2(ictra_static_oob, unsigned long, cmd, unsigned long, index)
+{
+	if (cmd != 0xFEEDFACE)
+		return -EINVAL;
+
+	/* Missing bound validation: index can exceed 15 */
+	global_buffer[index] = 'C';
+	return 0;
+}
+
